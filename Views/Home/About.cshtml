
@{
    ViewBag.Title = "Giới thiệu - SmartBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    /* ===== TỔNG THỂ ===== */
    .about-page {
        background: #f7faf8;
        color: #183b36;
        font-family: 'Be Vietnam Pro', sans-serif;
        padding-bottom: 60px;
    }

    /* ===== BANNER GIỚI THIỆU ===== */
    .about-hero {
        position: relative;
        min-height: 480px;
        display: flex;
        align-items: center;
        padding: 70px 9%;
        border-radius: 22px;
        overflow: hidden;
        background: linear-gradient(90deg, rgba(24, 59, 54, 0.92), rgba(31, 91, 78, 0.65)), url('/Images/padding.jpg') center/cover no-repeat;
        color: #ffffff;
        margin-bottom: 55px;
    }

    .about-hero-content {
        max-width: 650px;
        position: relative;
        z-index: 1;
    }

    .about-label {
        color: #f5d88b;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 18px;
    }

    .about-hero h1 {
        color: #ffffff;
        font-size: 43px;
        font-weight: 900;
        line-height: 1.3;
        margin-bottom: 20px;
    }

    .about-hero p {
        color: #edf5f1;
        font-size: 16px;
        line-height: 1.9;
        margin-bottom: 28px;
    }

    .about-button {
        display: inline-block;
        background: #f5d88b;
        color: #183b36;
        padding: 14px 28px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: 800;
        transition: 0.3s;
    }

        .about-button:hover {
            background: #ffffff;
            color: #204e43;
            transform: translateY(-3px);
        }

    /* ===== CÁC SECTION ===== */
    .about-section {
        padding: 75px 0;
    }

    .about-section-title {
        text-align: center;
        color: #183b36;
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .about-section-desc {
        text-align: center;
        color: #66877b;
        line-height: 1.8;
        margin-bottom: 35px;
    }

    .about-container {
        width: 90%;
        max-width: 1150px;
        margin: auto;
    }

    /* ===== TIÊU ĐỀ SECTION ===== */
    .section-heading {
        text-align: center;
        margin-bottom: 45px;
    }

        .section-heading span {
            color: #39766b;
            letter-spacing: 3px;
            font-size: 12px;
            font-weight: 800;
        }

        .section-heading h2 {
            font-size: 32px;
            font-weight: 800;
            margin-top: 12px;
            color: #183b36;
        }

        .section-heading p {
            color: #668077;
            margin-top: 12px;
        }

    /* ===== CÂU CHUYỆN SMARTBOOK ===== */
    .about-story {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 55px;
        align-items: center;
    }

        .about-story img {
            width: 100%;
            height: 360px;
            object-fit: cover;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(24, 59, 54, .12);
        }

        .about-story h2 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 20px;
            color: #183b36;
        }

        .about-story p {
            color: #668077;
            line-height: 2;
            font-size: 15px;
        }

    /* ===== TRÍCH DẪN SÁCH ===== */
    .quote-section {
        background: linear-gradient(120deg, #183b36, #39766b);
        padding: 70px 20px;
        text-align: center;
    }

    .quote-icon {
        font-size: 45px;
        color: #f5d88b;
    }

    .quote-section blockquote {
        max-width: 850px;
        margin: 20px auto;
        font-size: 25px;
        line-height: 1.8;
        font-weight: 600;
        color: #ffffff;
    }

    .quote-section p {
        color: #f5d88b;
        font-weight: 700;
        letter-spacing: 2px;
    }

    /* ===== GIÁ TRỊ SMARTBOOK ===== */
    .value-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .value-card {
        padding: 35px 25px;
        text-align: center;
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid #e1ece6;
        transition: .3s;
        box-shadow: 0 5px 20px rgba(24, 59, 54, .05);
    }

        .value-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(24, 59, 54, .12);
        }

        .value-card i {
            font-size: 35px;
            color: #39766b;
            margin-bottom: 20px;
        }

        .value-card h3 {
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 12px;
            color: #183b36;
        }

        .value-card p {
            color: #668077;
            line-height: 1.8;
            font-size: 14px;
        }

    /* ===== SÁCH ĐẶC SẮC ===== */
    .featured-section {
        background: #edf5f1;
    }

    .featured-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .featured-card {
        background: #ffffff;
        border: 1px solid #e1ece6;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(24, 59, 54, .06);
        transition: .3s;
    }

        .featured-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 25px rgba(24, 59, 54, .12);
        }

        .featured-card img {
            width: 100%;
            height: 245px;
            object-fit: contain;
            padding: 15px;
            background: #f1f7f4;
        }

    .featured-info {
        padding: 20px;
    }

        .featured-info h3 {
            font-size: 16px;
            font-weight: 800;
            min-height: 45px;
            line-height: 1.5;
            color: #183b36;
        }

        .featured-info p {
            color: #668077;
            font-size: 13px;
            margin: 10px 0 15px;
        }

    .featured-link {
        color: #39766b;
        font-weight: 700;
        text-decoration: none;
    }

        .featured-link:hover {
            color: #183b36;
            text-decoration: none;
        }

    /* ===== PHẦN KẾT THÚC ===== */
    .about-end {
        background: linear-gradient(120deg, #183b36, #39766b);
        color: #ffffff;
        text-align: center;
        padding: 65px 20px;
    }

        .about-end h2 {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 15px;
            color: #ffffff;
        }

        .about-end p {
            color: #e4f0ea;
            margin-bottom: 25px;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .about-hero h1 {
            font-size: 34px;
        }

        .about-story {
            grid-template-columns: 1fr;
        }

        .value-grid {
            grid-template-columns: 1fr;
        }

        .featured-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .quote-section blockquote {
            font-size: 19px;
        }
    }

    @@media (max-width: 480px) {
        .featured-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="about-page">

    <!-- BANNER GIỚI THIỆU -->
    <section class="about-hero">
        <div class="about-hero-content">
            <div class="about-label">WELCOME TO SMARTBOOK</div>
            <h1>Mỗi trang sách, một chân trời mới</h1>
            <p>
                SmartBook là không gian dành cho những người yêu sách,
                nơi tri thức được kết nối và những hành trình khám phá
                bắt đầu từ từng trang giấy.
            </p>
            <a href="@Url.Action("Index", "Products")" class="about-button">
                KHÁM PHÁ SÁCH <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </section>

    <!-- GIỚI THIỆU -->
    <section class="about-section">
        <div class="about-container">
            <div class="about-story">
                <div>
                    <img src="@Url.Content("~/Images/bannerweb.jpg")"
                         alt="Không gian đọc sách SmartBook" />
                </div>

                <div>
                    <span style="color:#a8865e;letter-spacing:3px;font-weight:800;">
                        CÂU CHUYỆN CỦA CHÚNG TÔI
                    </span>

                    <h2>SmartBook – Kết nối bạn với thế giới tri thức</h2>

                    <p>
                        Chúng tôi tin rằng mỗi cuốn sách đều chứa đựng
                        những giá trị riêng và có thể mở ra một góc nhìn
                        mới về cuộc sống.
                    </p>

                    <p>
                        SmartBook được xây dựng với mong muốn mang đến
                        một không gian mua sắm sách trực tuyến thuận tiện,
                        giúp bạn dễ dàng tìm kiếm, lựa chọn và khám phá
                        những cuốn sách phù hợp với sở thích của mình.
                    </p>

                    <p>
                        Dù bạn yêu thích văn học, kỹ năng sống hay công nghệ,
                        SmartBook luôn đồng hành cùng hành trình học hỏi
                        và phát triển bản thân của bạn.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- TRÍCH DẪN -->
    <section class="quote-section">
        <div class="quote-icon">
            <i class="fa-solid fa-quote-left"></i>
        </div>

        <blockquote>
            “Một cuốn sách hay không chỉ mang đến kiến thức,
            mà còn có thể thay đổi cách chúng ta nhìn nhận thế giới.”
        </blockquote>

        <p>THÔNG ĐIỆP CỦA SMARTBOOK</p>
    </section>

    <!-- GIÁ TRỊ -->
    <section class="about-section">
        <div class="about-container">
            <div class="section-heading">
                <span>GIÁ TRỊ CỦA CHÚNG TÔI</span>
                <h2>Điều làm nên SmartBook</h2>
                <p>Ba giá trị mà chúng tôi luôn hướng đến.</p>
            </div>

            <div class="value-grid">
                <div class="value-card">
                    <i class="fa-solid fa-book-open"></i>
                    <h3>Tri thức đa dạng</h3>
                    <p>
                        Cung cấp nhiều đầu sách thuộc các lĩnh vực
                        văn học, giáo dục, kỹ năng và công nghệ.
                    </p>
                </div>

                <div class="value-card">
                    <i class="fa-solid fa-heart"></i>
                    <h3>Trải nghiệm tận tâm</h3>
                    <p>
                        Hướng đến trải nghiệm tìm kiếm, lựa chọn
                        và mua sách đơn giản, thuận tiện.
                    </p>
                </div>

                <div class="value-card">
                    <i class="fa-solid fa-seedling"></i>
                    <h3>Phát triển mỗi ngày</h3>
                    <p>
                        Khuyến khích thói quen đọc sách và tinh thần
                        học hỏi không ngừng.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SÁCH NỔI BẬT -->
    <section class="about-section featured-section">
        <div class="about-container">
            <div class="section-heading">
                <span>BOOKS YOU MAY LOVE</span>
                <h2>Những cuốn sách đặc sắc</h2>
                <p>
                    Một vài gợi ý nổi bật dành cho hành trình khám phá
                    tri thức của bạn.
                </p>
            </div>

            <div class="featured-grid">

                <div class="featured-card">
                    <img src="@Url.Content("~/Images/thienthannhocuatoi.jpg")"
                         alt="Thiên thần nhỏ của tôi" />
                    <div class="featured-info">
                        <h3>Thiên thần nhỏ của tôi</h3>
                        <p>Nguyễn Nhật Ánh</p>
                        <a href="@Url.Action("Index", "Products")"
                           class="featured-link">
                            Khám phá sách →
                        </a>
                    </div>
                </div>

                <div class="featured-card">
                    <img src="@Url.Content("~/Images/sachthieunhi3.jpg")"
                         alt="Thỏ bảy màu" />
                    <div class="featured-info">
                        <h3>Thỏ bảy màu</h3>
                        <p>Huỳnh Thái Ngọc</p>
                        <a href="@Url.Action("Index", "Products")"
                           class="featured-link">
                            Khám phá sách →
                        </a>
                    </div>
                </div>

                <div class="featured-card">
                    <img src="@Url.Content("~/Images/dacnhantam.jpg")"
                         alt="Đắc Nhân Tâm" />
                    <div class="featured-info">
                        <h3>Đắc Nhân Tâm</h3>
                        <p>Dale Carnegie</p>
                        <a href="@Url.Action("Index", "Products")"
                           class="featured-link">
                            Khám phá sách →
                        </a>
                    </div>
                </div>

                <div class="featured-card">
                    <img src="@Url.Content("~/Images/bigdata.jpg")"
                         alt="Big Data - Dữ Liệu Lớn" />
                    <div class="featured-info">
                        <h3>Big Data - Dữ Liệu Lớn</h3>
                        <p>Bernard Marr</p>
                        <a href="@Url.Action("Index", "Products")"
                           class="featured-link">
                            Khám phá sách →
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- KẾT THÚC -->
    <section class="about-end">
        <h2>Bắt đầu hành trình cùng SmartBook</h2>
        <p>
            Hãy để mỗi ngày là một cơ hội mới để đọc, học hỏi và trưởng thành.
        </p>

        <a href="@Url.Action("Index", "Products")" class="about-button">
            MUA SÁCH NGAY
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </section>

</div>
